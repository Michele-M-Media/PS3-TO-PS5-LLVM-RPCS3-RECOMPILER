+"""Build reviewed SDK memory/TLS extensions without replacing the installed SDK."""
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--repository', type=Path, required=True)
+parser.add_argument('--sdk', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+revision = 'b5efad528e0ac1b8289f39d72a0e890ff68ff0a6'
+output = args.output.resolve()
+for directory in ['source', 'include/ps5platform', 'objects']:
+    (output / directory).mkdir(parents=True, exist_ok=True)
+def source(name):
+    return subprocess.check_output(['git', '-C', str(args.repository), 'show', revision + ':platform/' + name])
+header = source('include/ps5platform/shm.h').decode()
+field = '   uint64_t committed_bytes; /* ps5_vrange_commit\'s units */\n'
+if header.count(field) != 1: raise RuntimeError('Review the pinned shared-memory stats ABI')
+header = header.replace(field, '')
+(output / 'include/ps5platform/shm.h').write_text(header)
+records = []
+environment = dict(os.environ)
+environment['PATH'] = '/usr/local/bin:/usr/bin:/bin'
+for name in ['cxa', 'threads', 'shm']:
+    original = source('src/' + name + '.c')
+    text = original.decode()
+    if name == 'shm':
+        line = '   stats->committed_bytes = atomic_load(&committed_bytes);\n'
+        if text.count(line) != 1: raise RuntimeError('Review the pinned shared-memory stats writer')
+        text = text.replace(line, '')
+    path = output / 'source' / (name + '.c')
+    path.write_text(text)
+    command = [str(args.sdk / 'bin/prospero-clang'), '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror',
+        '-fPIC', '-ffunction-sections', '-fdata-sections', '-I' + str(output / 'include'),
+        '-I' + str(args.repository / 'platform/include'), '-I' + str(args.repository / 'platform/src'),
+        '-c', str(path), '-o', str(output / 'objects' / (name + '.o'))]
+    result = subprocess.run(command, env=environment, capture_output=True, text=True)
+    log = result.stdout + result.stderr
+    (output / (name + '.compile.log')).write_text(log)
+    records.append({'file': 'platform/src/' + name + '.c', 'source_revision': revision,
+                    'original_sha256': hashlib.sha256(original).hexdigest(),
+                    'adapted_sha256': hashlib.sha256(text.encode()).hexdigest(),
+                    'object': str(output / 'objects' / (name + '.o')), 'command': command,
+                    'returncode': result.returncode})
+    print(json.dumps({'step': 'native-runtime-' + name, 'returncode': result.returncode, 'output': log[-3000:]}), flush=True)
+    if result.returncode: raise SystemExit(result.returncode)
+report = {'source_url': 'https://github.com/lavavex/PS5_PayloadSDK/tree/' + revision,
+          'revision': revision, 'objects': records, 'sdk_replaced': False,
+          'shared_memory_stats_abi': 'Preserves the existing six uint64_t fields (48 bytes); no extended stats writer is exported',
+          'device_tested': False}
+(output / 'manifest.json').write_text(json.dumps(report, indent=2) + '\n')
+(Path(__file__).resolve().parents[1] / 'runtime-extension-build.json').write_text(json.dumps(report, indent=2) + '\n')

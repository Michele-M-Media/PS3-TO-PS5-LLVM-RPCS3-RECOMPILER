+
+#include <map>
+
+// A DualSense through ScePad, one per signed-in user (players 1-4)
+class ps5_pad_device : public PadDevice
+{
+public:
+	s32 user = -1;
+	s32 handle = -1;
+	bool connected = false;
+	ps5::pad_sample last{};
+	u8 large_motor = 0;
+	u8 small_motor = 0;

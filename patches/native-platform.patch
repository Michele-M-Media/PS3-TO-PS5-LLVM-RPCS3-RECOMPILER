+"""Isolate Mesa's C11 thread emulation from the payload SDK's C11 ABI."""
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--archive', type=Path, required=True)
+parser.add_argument('--libc', type=Path, required=True)
+parser.add_argument('--nm', required=True)
+parser.add_argument('--objcopy', required=True)
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+archive = args.archive.resolve(strict=True)
+output = args.output.resolve()
+if output == archive or archive.parent == output.parent:
+    parser.error('Use a private output directory, outside the original RADV installation')
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+def definitions(path):
+    text = subprocess.run([args.nm, '--defined-only', '--extern-only', str(path)],
+                          check=True, capture_output=True, text=True).stdout
+    return {words[-1] for line in text.splitlines()
+            if len(words := line.split()) >= 2 and len(words[-2]) == 1 and words[-2].isalpha()}
+
+inputs = {str(path): digest(path) for path in [archive, args.libc, Path(__file__)]}
+manifest = output.with_suffix('.namespace.json')
+if manifest.exists() and output.exists():
+    cached = json.loads(manifest.read_text())
+    if cached.get('inputs') == inputs and cached.get('output_sha256') == digest(output):
+        print(json.dumps({'archive': str(output), 'renamed': cached['renamed'], 'cached': True}))
+        raise SystemExit(0)
+original = definitions(archive)
+common = sorted(original & definitions(args.libc))
+if any(not re.fullmatch(r'call_once|(?:cnd|mtx|thrd|tss)_[A-Za-z0-9_]+', name) for name in common):
+    parser.error('Unexpected non-C11 collision with SDK libc: ' + ', '.join(common))
+prefix = 'rpcs3_ps5_vk_private_'
+if any(name.startswith(prefix) for name in original):
+    parser.error('Reserved namespace already exists')
+output.parent.mkdir(parents=True, exist_ok=True)
+mapping = output.with_suffix('.symbols.map')
+mapping.write_text(''.join(f'{name} {prefix}{name}\n' for name in common))
+temporary = output.with_suffix('.tmp')
+subprocess.run([args.objcopy, '--redefine-syms=' + str(mapping),
+                str(archive), str(temporary)], check=True, capture_output=True)
+rewritten = definitions(temporary)
+if (rewritten & set(common) or {prefix + name for name in common} - rewritten or
+        {name for name in original if name.startswith(('vk', 'radv_'))} !=
+        {name for name in rewritten if name.startswith(('vk', 'radv_'))}):
+    raise RuntimeError('RADV namespace verification failed')
+temporary.replace(output)
+report = {'inputs': inputs, 'renamed': len(common), 'symbols': common,
+          'public_entry_points_preserved': True, 'shared_c11_definitions_remaining': 0,
+          'output_sha256': digest(output)}
+manifest.write_text(json.dumps(report, indent=2) + '\n')
+print(json.dumps({'archive': str(output), 'renamed': len(common), 'cached': False}))

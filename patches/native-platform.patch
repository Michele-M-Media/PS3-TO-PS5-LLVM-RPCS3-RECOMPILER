@@ -0,0 +1,55 @@
+"""Adapt LLVM's four process-loader references in a private archive copy."""
+import argparse
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--archive', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+parser.add_argument('--nm', required=True)
+parser.add_argument('--objcopy', required=True)
+args = parser.parse_args()
+archive = args.archive.resolve(strict=True)
+output = args.output.resolve()
+if output == archive or output.parent == archive.parent:
+    parser.error('Use a private output directory outside the LLVM build/install library directory')
+def digest(path):
+    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()
+def symbols(path, flag):
+    result = subprocess.run([args.nm, '--extern-only', flag, str(path)],
+                            capture_output=True, text=True, check=True)
+    return {parts[-1] for line in result.stdout.splitlines()
+            if len(parts := line.split()) >= 2 and len(parts[-2]) == 1 and parts[-2].isalpha()}
+names = ['dlopen', 'dlsym', 'dlerror', 'dlclose']
+mapping = {name: 'rpcs3_ps5_llvm_' + name for name in names}
+inputs = {'archive': str(archive), 'archive_sha256': digest(archive),
+          'adapter_sha256': digest(Path(__file__)), 'renames': mapping}
+manifest = output.with_suffix('.interop.json')
+if manifest.exists() and output.exists():
+    cached = json.loads(manifest.read_text())
+    if cached.get('inputs') == inputs and cached.get('output_sha256') == digest(output):
+        print(json.dumps({'archive': str(output), 'cached': True, 'references_renamed': 4}))
+        raise SystemExit(0)
+undefined = symbols(archive, '--undefined-only')
+defined = symbols(archive, '--defined-only')
+if not set(names).issubset(undefined) or set(names) & defined or set(mapping.values()) & (undefined | defined):
+    raise RuntimeError('Review pinned LLVM loader references before adapting this archive')
+output.parent.mkdir(parents=True, exist_ok=True)
+map_file = output.with_suffix('.symbols.map')
+map_file.write_text(''.join(name + ' ' + replacement + '\n' for name, replacement in mapping.items()))
+temporary = output.with_suffix('.tmp')
+subprocess.run([args.objcopy, '--redefine-syms=' + str(map_file), str(archive), str(temporary)],
+                check=True, capture_output=True)
+after_undefined = symbols(temporary, '--undefined-only')
+if set(names) & after_undefined or not set(mapping.values()).issubset(after_undefined):
+    raise RuntimeError('LLVM loader reference rewrite failed')
+if defined != symbols(temporary, '--defined-only'):
+    raise RuntimeError('An LLVM definition changed while adapting process-loader references')
+temporary.replace(output)
+report = {'inputs': inputs, 'output_sha256': digest(output),
+          'definitions_preserved': True, 'references_renamed': 4,
+          'global_application_dl_functions_overridden': False, 'device_tested': False}
+manifest.write_text(json.dumps(report, indent=2) + '\n')
+print(json.dumps({'archive': str(output), 'cached': False, 'references_renamed': 4}))

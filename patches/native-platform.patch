+        const auto directoryExists = [](const QByteArray &path) {
+            struct stat info{};
+            return ::stat(path.constData(), &info) == 0 && S_ISDIR(info.st_mode);
+        };
+        QByteArray appRoot(native_paths::app_directory().c_str());
+        if (appRoot.size() > 1) appRoot.chop(1);

+include_guard(GLOBAL)
+set(_RPCS3_PS5_NATIVE_APP_DIR "${CMAKE_CURRENT_LIST_DIR}")
+function(rpcs3_ps5_native_application target)
+    if(NOT PS5 OR NOT TARGET ${target})
+        message(FATAL_ERROR "A PS5 executable target is required")
+    endif()
+    set(_native "${RPCS3_PS5_VULKAN_ROOT}/tooling/native")
+    foreach(_file app_crt.cpp app-symbols.map)
+        if(NOT EXISTS "${_native}/${_file}")
+            message(FATAL_ERROR "Missing pinned native application startup: ${_file}")
+        endif()
+    endforeach()
+    target_sources(${target} PRIVATE "${_native}/app_crt.cpp")
+    target_sources(${target} PRIVATE "${_RPCS3_PS5_NATIVE_APP_DIR}/native_posix.c")
+    target_sources(${target} PRIVATE "${_RPCS3_PS5_NATIVE_APP_DIR}/native_filesystem.c")
+    set_source_files_properties("${_native}/app_crt.cpp"
+        "${_RPCS3_PS5_NATIVE_APP_DIR}/native_posix.c"
+        "${_RPCS3_PS5_NATIVE_APP_DIR}/native_filesystem.c" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
+    foreach(_name mkstemp isatty link symlink readlink pathconf if_nametoindex gai_strerror getnameinfo wcsdup)
+        target_link_options(${target} PRIVATE "LINKER:--defsym=${_name}=rpcs3_ps5_${_name}")
+    endforeach()
+    # RADV's upstream recipe aliases statvfs to the SDK's synthetic counter
+    # provider. Redirect that provider symbol to our actual _fstatfs adapter.
+    target_link_options(${target} PRIVATE
+        "LINKER:--defsym=ps5_statvfs=rpcs3_ps5_statvfs"
+        "LINKER:--defsym=ps5_fstatvfs=rpcs3_ps5_fstatvfs")
+    foreach(_name cxa threads shm)
+        set(_object "${RPCS3_PS5_RUNTIME_EXTENSION_ROOT}/objects/${_name}.o")
+        if(NOT EXISTS "${_object}")
+            message(FATAL_ERROR "Native applications require the reviewed memory/TLS extension: ${_object}")
+        endif()
+        target_sources(${target} PRIVATE "${_object}")
+    endforeach()
+    target_include_directories(${target} PRIVATE "${RPCS3_PS5_RUNTIME_EXTENSION_ROOT}/include")
+    if(TARGET Qt6::Multimedia)
+        # Qt 6.8's static FFmpeg plugin intentionally leaves the FFmpeg
+        # libraries to its consumer. Supply the same native build as RPCS3.
+        if(NOT RPCS3_PS5_FFMPEG_ROOT)
+            message(FATAL_ERROR "Set RPCS3_PS5_FFMPEG_ROOT to the native static FFmpeg prefix")
+        endif()
+        foreach(_name avformat avcodec swresample swscale avutil)
+            set(_archive "${RPCS3_PS5_FFMPEG_ROOT}/lib/lib${_name}.a")
+            if(NOT EXISTS "${_archive}")
+                message(FATAL_ERROR "Missing native FFmpeg archive: ${_archive}")
+            endif()
+            target_link_libraries(${target} PRIVATE "${_archive}")
+        endforeach()
+    endif()
+    # Use application process parameters and constructor arrays, rather than
+    # the payload SDK's loader-specific crt1. Keep the real full libc++ ABI.
+    target_link_options(${target} PRIVATE -nostartfiles -nodefaultlibs
+        "LINKER:--build-id=none" "LINKER:-z,nodynamic-undefined-weak"
+        "LINKER:--eh-frame-hdr" "LINKER:-e,_start"
+        "LINKER:--version-script,${_native}/app-symbols.map"
+        "LINKER:--version-script,${_RPCS3_PS5_NATIVE_APP_DIR}/native-title-local.map"
+        "LINKER:--exclude-libs,ALL")
+    target_link_libraries(${target} PRIVATE RPCS3::PS5Vulkan)
+    # These are host-link descriptors for imports; they are never packaged.
+    file(GLOB _system_imports "${PS5_PAYLOAD_SDK}/target/lib/*.so")
+    list(FILTER _system_imports EXCLUDE REGEX "/(libkernel_sys|libScePosixForWebKit)[.]so$")
+    target_link_libraries(${target} PRIVATE SceLibcInternal kernel_web SceNet
+        "-Wl,--as-needed" ${_system_imports} "-Wl,--no-as-needed")

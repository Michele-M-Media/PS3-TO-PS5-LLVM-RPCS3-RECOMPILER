+#include "vulkan_runtime.h"
+#include <mutex>
+
+// Entry point exported by the pinned PS5 RADV static archive. This bypasses
+// desktop ICD discovery; no Windows DLL or Linux libvulkan is loaded.
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetInstanceProcAddr(VkInstance instance, const char* name);
+
+namespace rpcs3::ps5
+{
+    bool initialize_vulkan()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] { volkInitializeCustom(vk_icdGetInstanceProcAddr); });
+        return vkCreateInstance && vkEnumerateInstanceExtensionProperties &&
+               vkEnumerateInstanceLayerProperties;
+    }
+
+    void load_vulkan_instance(VkInstance instance)
+    {
+        volkLoadInstance(instance);
+    }
+
+    void load_vulkan_device(VkDevice device)
+    {
+        volkLoadDevice(device);
+    }
+}

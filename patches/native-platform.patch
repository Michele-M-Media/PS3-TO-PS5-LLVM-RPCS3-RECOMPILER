+/* Native title filesystem statistics, using the exported libkernel _fstatfs.
+ * The SDK mount.h ABI matches the supplied libkernel syscall and libc's
+ * fstatvfs conversion. No firmware code or runtime addresses are embedded.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/vfs.h>
+#define native_fstatfs fstatfs
+#else
+#include <sys/mount.h>
+extern int _fstatfs(int, struct statfs *);
+#define native_fstatfs _fstatfs
+/* The supplied libc uses a 472-byte statfs buffer and these field positions. */
+_Static_assert(sizeof(struct statfs) == 472, "Review native statfs ABI");
+_Static_assert(offsetof(struct statfs, f_flags) == 8, "Review native mount flags");
+_Static_assert(offsetof(struct statfs, f_bsize) == 16, "Review native fragment size");
+_Static_assert(offsetof(struct statfs, f_iosize) == 24, "Review native transfer size");
+_Static_assert(offsetof(struct statfs, f_blocks) == 32, "Review native block counters");
+_Static_assert(offsetof(struct statfs, f_bavail) == 48, "Review native available blocks");
+_Static_assert(offsetof(struct statfs, f_files) == 56, "Review native file counters");
+_Static_assert(offsetof(struct statfs, f_ffree) == 64, "Review native free files");
+#endif
+
+int rpcs3_ps5_fstatvfs(int fd, struct statvfs *result)
+{
+    if (!result) { errno = EFAULT; return -1; }
+    struct statfs status = {0};
+    if (native_fstatfs(fd, &status) != 0) return -1;
+#ifndef __linux__
+    if (status.f_version != STATFS_VERSION) { errno = EIO; return -1; }
+#endif
+    if (status.f_bsize <= 0) { errno = EIO; return -1; }
+    struct statvfs converted = {0};
+    converted.f_blocks = status.f_blocks;
+    converted.f_bfree = status.f_bfree;
+    /* statfs counters can be negative for reserved/overcommitted resources. */
+    converted.f_bavail = status.f_bavail > 0 ? (fsblkcnt_t)status.f_bavail : 0;
+    converted.f_files = status.f_files;
+    converted.f_ffree = status.f_ffree > 0 ? (fsfilcnt_t)status.f_ffree : 0;
+    converted.f_favail = converted.f_ffree;
+    converted.f_frsize = (unsigned long)status.f_bsize;
+#ifdef __linux__
+    if (status.f_frsize > 0) converted.f_frsize = (unsigned long)status.f_frsize;
+    converted.f_bsize = (unsigned long)status.f_bsize;
+    converted.f_flag = (unsigned long)status.f_flags & (ST_RDONLY | ST_NOSUID);
+    converted.f_namemax = (unsigned long)status.f_namelen;
+#else
+    converted.f_bsize = status.f_iosize ? (unsigned long)status.f_iosize : converted.f_frsize;
+    if (status.f_flags & MNT_RDONLY) converted.f_flag |= ST_RDONLY;
+    if (status.f_flags & MNT_NOSUID) converted.f_flag |= ST_NOSUID;
+    converted.f_namemax = status.f_namemax;
+#endif
+    /* POSIX does not prescribe a numeric interpretation of f_fsid. */
+    const size_t id_size = sizeof(converted.f_fsid) < sizeof(status.f_fsid)
+        ? sizeof(converted.f_fsid) : sizeof(status.f_fsid);
+    memcpy(&converted.f_fsid, &status.f_fsid, id_size);
+    *result = converted;
+    return 0;
+}
+
+int rpcs3_ps5_statvfs(const char *path, struct statvfs *result)
+{
+    if (!path || !result) { errno = EFAULT; return -1; }
+    /* NONBLOCK avoids blocking forever when the path names a FIFO/device. */
+    const int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) return -1;
+    const int value = rpcs3_ps5_fstatvfs(fd, result);
+    const int saved = errno;
+    close(fd);
+    errno = saved;
+    return value;
+}

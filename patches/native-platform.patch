+// Native-title exit pattern used by PS5_DevilutionX and the public RPCS3 port.
+// The shell closes the title asynchronously after QApplication has shut down.
+extern "C" void catchReturnFromMain(int status)
+{
+    std::fprintf(stderr, "RPCS3 Qt app: main returned %d; requesting native exit\n", status);
+    std::fflush(nullptr);
+    const int result = sceSystemServiceLoadExec("exit", nullptr);
+    if (result != 0) {
+        std::fprintf(stderr, "RPCS3 Qt app: native exit failed: 0x%08x\n", unsigned(result));
+        return;
+    }
+    for (;;) sceKernelUsleep(100000);

+"""Expose the pinned upstream RADV link recipe to CMake without rewriting it."""
+import argparse
+import fcntl
+import json
+import os
+import shlex
+import shutil
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--driver-root', required=True, type=Path)
+parser.add_argument('--sdk', required=True, type=Path)
+parser.add_argument('--archive', required=True, type=Path)
+args = parser.parse_args()
+script = r'''set -euo pipefail
+source "$1/tools/radv-link.sh"
+radv_link_recipe "$1" "$2" "$3"
+printf '%s\0' "${#radv_linker_script[@]}" "${radv_linker_script[@]}"
+printf '%s\0' "${#radv_link_inputs[@]}" "${radv_link_inputs[@]}"
+printf '%s\0' "${#radv_link_flags[@]}" "${radv_link_flags[@]}"
+'''
+shared = args.driver_root / 'build'
+shared.mkdir(exist_ok=True)
+private_map = args.archive.parent / 'radv-platform-local.map'
+with (shared / 'rpcs3-radv-recipe.lock').open('a') as lock:
+    fcntl.flock(lock, fcntl.LOCK_EX)
+    result = subprocess.run(['bash', '-c', script, 'rpcs3-radv', str(args.driver_root),
+                             str(args.sdk), str(args.archive)], check=True, capture_output=True)
+    shutil.copyfile(shared / 'radv-platform-local.map', private_map)
+parts = result.stdout.decode().split('\0')
+groups = []
+for _ in range(3):
+    count = int(parts.pop(0))
+    groups.append(parts[:count])
+    del parts[:count]
+link_script, inputs, flags = groups
+flags = [str(private_map) if item == str(shared / 'radv-platform-local.map') else item for item in flags]
+libraries = []
+index = 0
+while index < len(inputs):
+    value = inputs[index]
+    if value == '-L':
+        index += 1
+        libraries.append('-L' + inputs[index])
+    elif value.startswith('--'):
+        libraries.append('-Wl,' + value)
+    else:
+        libraries.append(value)
+    index += 1
+print(json.dumps({'libraries': libraries,
+                  'options': ['LINKER:SHELL:' + shlex.join(link_script + flags)]}))

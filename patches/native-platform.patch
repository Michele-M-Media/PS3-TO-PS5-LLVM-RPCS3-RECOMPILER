+/* Native-title POSIX adapters.
+ * mkstemp/isatty/link/symlink/readlink adapted from PS5 Platform posix.c,
+ * Copyright (C) 2026 Mihawk, SPDX-License-Identifier: GPL-3.0-or-later
+ * Source: lavavex/PS5_PayloadSDK b5efad528e0ac1b8289f39d72a0e890ff68ff0a6
+ * Altered: separate adapter object; symbolic links report ENOSYS if present;
+ * pathconf reports indeterminate limits instead of fabricating filesystem data.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <stddef.h>
+#include <net/if.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#ifndef __linux__
+#include <sys/sockio.h>
+#endif
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <wchar.h>
+
+wchar_t *rpcs3_ps5_wcsdup(const wchar_t *text)
+{
+    const size_t length = wcslen(text);
+    if (length >= SIZE_MAX / sizeof(wchar_t)) { errno = ENOMEM; return NULL; }
+    const size_t bytes = (length + 1) * sizeof(wchar_t);
+    wchar_t *copy = malloc(bytes);
+    if (!copy) { errno = ENOMEM; return NULL; }
+    memcpy(copy, text, bytes);
+    return copy;
+}
+
+extern int ps5_mkstemps(char *, int);
+int rpcs3_ps5_mkstemp(char *name) { return ps5_mkstemps(name, 0); }
+int rpcs3_ps5_isatty(int fd)
+{
+    errno = fcntl(fd, F_GETFD) == -1 ? EBADF : ENOTTY;
+    return 0;
+}
+int rpcs3_ps5_link(const char *existing, const char *name)
+{
+    (void)existing; (void)name;
+    errno = EOPNOTSUPP;
+    return -1;
+}
+int rpcs3_ps5_symlink(const char *target, const char *name)
+{
+    (void)target; (void)name;
+    errno = EPERM;
+    return -1;
+}
+ssize_t rpcs3_ps5_readlink(const char *path, char *buffer, size_t size)
+{
+    (void)buffer; (void)size;
+    struct stat status;
+    if (lstat(path, &status) != 0) return -1;
+    errno = S_ISLNK(status.st_mode) ? ENOSYS : EINVAL;
+    return -1;
+}
+long rpcs3_ps5_pathconf(const char *path, int name)
+{
+    struct stat status;
+    if (stat(path, &status) != 0) return -1;
+    if (name != _PC_NAME_MAX && name != _PC_PATH_MAX) {
+        errno = EINVAL;
+        return -1;
+    }
+    /* POSIX: -1 with errno unchanged/zero means an indeterminate limit. */
+    errno = 0;
+    return -1;
+}
+
+unsigned int rpcs3_ps5_if_nametoindex(const char *name)
+{
+    /* Query the real BSD socket interface; never synthesize an interface ID.
+     * The SDK declares SIOCGIFINDEX and ifreq.ifr_index in sys/sockio.h/net/if.h.
+     * Console permission/availability errors are returned to the caller.
+     */
+    struct ifreq request;
+    if (!name) { errno = EINVAL; return 0; }
+    const size_t size = strlen(name);
+    if (size == 0 || size >= sizeof(request.ifr_name)) { errno = ENXIO; return 0; }
+    memset(&request, 0, sizeof(request));
+    memcpy(request.ifr_name, name, size + 1);
+    const int descriptor = socket(AF_INET, SOCK_DGRAM, 0);
+    if (descriptor < 0) return 0;
+    const int result = ioctl(descriptor, SIOCGIFINDEX, &request);
+    const int saved_errno = errno;
+    close(descriptor);
+    if (result < 0) { errno = saved_errno; return 0; }
+#ifdef __linux__
+    return (unsigned int)request.ifr_ifindex;
+#else
+    return (unsigned short)request.ifr_index;
+#endif
+}
+
+const char *rpcs3_ps5_gai_strerror(int error)
+{
+    switch (error) {
+    case 0: return "Success";
+#ifdef EAI_ADDRFAMILY
+    case EAI_ADDRFAMILY: return "Address family not supported for this host";
+#endif
+    case EAI_AGAIN: return "Temporary name resolution failure";
+    case EAI_BADFLAGS: return "Invalid address lookup flags";
+    case EAI_FAIL: return "Name resolution failed";
+    case EAI_FAMILY: return "Unsupported address family";
+    case EAI_MEMORY: return "Memory allocation failure";
+#if defined(EAI_NODATA) && EAI_NODATA != EAI_NONAME
+    case EAI_NODATA: return "No address associated with this host";
+#endif
+    case EAI_NONAME: return "Host or service name not found";
+    case EAI_SERVICE: return "Unsupported service";
+    case EAI_SOCKTYPE: return "Unsupported socket type";
+    case EAI_SYSTEM: return "System error; inspect errno";
+#ifdef EAI_BADHINTS
+    case EAI_BADHINTS: return "Invalid address lookup hints";
+#endif
+#ifdef EAI_PROTOCOL
+    case EAI_PROTOCOL: return "Unknown protocol";
+#endif
+    case EAI_OVERFLOW: return "Address buffer too small";
+    default: return "Unknown address lookup error";
+    }
+}
+
+int rpcs3_ps5_getnameinfo(const struct sockaddr *address, socklen_t length,
+                         char *host, socklen_t host_size,
+                         char *service, socklen_t service_size, int flags)
+{
+    /* Numeric IPv4/IPv6 and ports work without a POSIX resolver database.
+     * Default lookups use the permitted numeric fallback. A caller requiring
+     * a reverse DNS name receives EAI_NONAME, never a fabricated host name.
+     */
+    int supported_flags = NI_NOFQDN | NI_NUMERICHOST | NI_NAMEREQD | NI_NUMERICSERV | NI_DGRAM;
+#ifdef NI_WITHSCOPEID
+    supported_flags |= NI_WITHSCOPEID;
+#endif
+    if (flags & ~supported_flags) return EAI_BADFLAGS;
+    if (!address || length < offsetof(struct sockaddr, sa_family) + sizeof(address->sa_family))
+        return EAI_FAMILY;
+    if ((!host || !host_size) && (!service || !service_size)) return EAI_NONAME;
+    const void *binary;
+    unsigned int port, scope = 0;
+    if (address->sa_family == AF_INET && length >= sizeof(struct sockaddr_in)) {
+        const struct sockaddr_in *ipv4 = (const struct sockaddr_in *)address;
+        binary = &ipv4->sin_addr;
+        port = ntohs(ipv4->sin_port);
+    } else if (address->sa_family == AF_INET6 && length >= sizeof(struct sockaddr_in6)) {
+        const struct sockaddr_in6 *ipv6 = (const struct sockaddr_in6 *)address;
+        binary = &ipv6->sin6_addr;
+        port = ntohs(ipv6->sin6_port);
+        scope = ipv6->sin6_scope_id;
+    } else return EAI_FAMILY;
+    if (host && host_size && (flags & NI_NAMEREQD) && !(flags & NI_NUMERICHOST)) return EAI_NONAME;
+    char numeric[INET6_ADDRSTRLEN], scoped[INET6_ADDRSTRLEN + 12], port_text[6];
+    if (!inet_ntop(address->sa_family, binary, numeric, sizeof(numeric))) return EAI_SYSTEM;
+    const char *host_text = numeric;
+    if (scope) {
+        snprintf(scoped, sizeof(scoped), "%s%%%u", numeric, scope);
+        host_text = scoped;
+    }
+    snprintf(port_text, sizeof(port_text), "%u", port);
+    const size_t host_length = strlen(host_text) + 1, port_length = strlen(port_text) + 1;
+    if ((host && host_size && host_length > host_size) ||
+        (service && service_size && port_length > service_size)) return EAI_OVERFLOW;
+    if (host && host_size) memcpy(host, host_text, host_length);
+    if (service && service_size) memcpy(service, port_text, port_length);
+    return 0;
+}

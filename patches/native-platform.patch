+"""Keep the two pinned Mesa builds independent in a single native executable.
+
+Only definitions shared with RADV/platform are renamed, in private copies of
+every archive in the SDK GROUP. References are rewritten with the same map.
+Public GL/EGL/PS5 entry points and the original SDK are preserved.
+"""
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--sdk', type=Path, required=True)
+parser.add_argument('--external', type=Path, action='append', required=True)
+parser.add_argument('--nm', required=True)
+parser.add_argument('--objcopy', required=True)
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+library = args.sdk.resolve(strict=True) / 'lib'
+output = args.output.resolve()
+if output == library or library in output.parents:
+    parser.error('Private archives must be outside the original SDK')
+script = (library / 'libPS5OpenGL.a').read_text()
+names = re.findall(r'\blib[A-Za-z0-9_.+-]+\.a\b', script)
+if not names or len(names) != len(set(names)):
+    parser.error('Unexpected OpenGL GROUP script; review this SDK release')
+archives = [library / name for name in names]
+
+def digest(path):
+    return hashlib.file_digest(path.open('rb'), 'sha256').hexdigest()
+
+def definitions(paths):
+    text = subprocess.run([args.nm, '--defined-only', '--extern-only', *map(str, paths)],
+                          check=True, capture_output=True, text=True).stdout
+    found = set()
+    for line in text.splitlines():
+        words = line.split()
+        if len(words) >= 2 and len(words[-2]) == 1 and words[-2].isalpha():
+            found.add(words[-1])
+    return found
+
+inputs = {str(path): digest(path) for path in [*archives, *args.external]}
+inputs['script'] = hashlib.sha256(script.encode()).hexdigest()
+inputs['adapter'] = digest(Path(__file__))
+manifest = output / 'namespace.json'
+if manifest.exists():
+    cached = json.loads(manifest.read_text())
+    if cached.get('inputs') == inputs and all((output / name).is_file() and
+            digest(output / name) == sha for name, sha in cached['outputs'].items()):
+        print(json.dumps({'script': str(output / 'libPS5OpenGL.a'),
+                          'renamed': cached['renamed'], 'cached': True}))
+        raise SystemExit(0)
+
+original = definitions(archives)
+external = definitions(args.external)
+common = sorted(original & external)
+public = lambda name: bool(re.match(r'^(gl|egl)[A-Z]', name)) or name.startswith('ps5_')
+if any(public(name) for name in common):
+    parser.error('A public API collides; review it instead of renaming an ABI entry point')
+prefix = 'rpcs3_ps5_gl_private_'
+if any(name.startswith(prefix) for name in original | external):
+    parser.error('Reserved namespace already exists in the inputs')
+output.mkdir(parents=True, exist_ok=True)
+mapping = output / 'symbols.map'
+mapping.write_text(''.join(f'{name} {prefix}{name}\n' for name in common))
+for archive in archives:
+    temporary = output / (archive.name + '.tmp')
+    subprocess.run([args.objcopy, '--redefine-syms=' + str(mapping),
+                    str(archive), str(temporary)], check=True, capture_output=True)
+    temporary.replace(output / archive.name)
+
+rewritten = definitions([output / name for name in names])
+if (rewritten & set(common) or
+        {prefix + name for name in common} - rewritten or
+        {name for name in original if public(name)} != {name for name in rewritten if public(name)}):
+    raise RuntimeError('Namespace verification failed; no new manifest was published')
+(output / 'libPS5OpenGL.a').write_text(script)
+report = {'inputs': inputs, 'renamed': len(common), 'symbols': common,
+          'public_entry_points_preserved': True, 'shared_private_definitions_remaining': 0,
+          'outputs': {name: digest(output / name) for name in [*names, 'libPS5OpenGL.a']}}
+manifest.write_text(json.dumps(report, indent=2) + '\n')
+print(json.dumps({'script': str(output / 'libPS5OpenGL.a'),
+                  'renamed': len(common), 'cached': False}))

diff --git a/src/amd/vulkan/winsys/ps5/submit-dispatch.h b/src/amd/vulkan/winsys/ps5/submit-dispatch.h
new file mode 100644
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps5/submit-dispatch.h
@@ -0,0 +1,77 @@
+#pragma once
+
+/* The caller serializes publication. The worker never takes the caller's
+ * lock. One job slot bounds host work ahead of native submission. */
+struct submit_dispatch {
+   mtx_t mutex;
+   cnd_t changed;
+   thrd_t thread;
+   void (*execute)(void *);
+   void *data;
+   bool stopping;
+};
+
+static int submit_dispatch_run(void *opaque)
+{
+   struct submit_dispatch *dispatch = opaque;
+   mtx_lock(&dispatch->mutex);
+   for (;;) {
+      while (!dispatch->data && !dispatch->stopping)
+         cnd_wait(&dispatch->changed, &dispatch->mutex);
+      if (!dispatch->data)
+         break;
+      void *job = dispatch->data;
+      mtx_unlock(&dispatch->mutex);
+      dispatch->execute(job);
+      mtx_lock(&dispatch->mutex);
+      dispatch->data = NULL;
+      cnd_broadcast(&dispatch->changed);
+   }
+   mtx_unlock(&dispatch->mutex);
+   return 0;
+}
+
+static bool submit_dispatch_start(struct submit_dispatch *dispatch, void (*execute)(void *))
+{
+   dispatch->execute = execute;
+   if (mtx_init(&dispatch->mutex, mtx_plain) != thrd_success)
+      return false;
+   if (cnd_init(&dispatch->changed) != thrd_success) {
+      mtx_destroy(&dispatch->mutex);
+      return false;
+   }
+   if (thrd_create(&dispatch->thread, submit_dispatch_run, dispatch) != thrd_success) {
+      cnd_destroy(&dispatch->changed);
+      mtx_destroy(&dispatch->mutex);
+      return false;
+   }
+   return true;
+}
+
+static void submit_dispatch_wait(struct submit_dispatch *dispatch)
+{
+   mtx_lock(&dispatch->mutex);
+   while (dispatch->data)
+      cnd_wait(&dispatch->changed, &dispatch->mutex);
+   mtx_unlock(&dispatch->mutex);
+}
+
+static void submit_dispatch_publish(struct submit_dispatch *dispatch, void *job)
+{
+   mtx_lock(&dispatch->mutex);
+   assert(!dispatch->data && job);
+   dispatch->data = job;
+   cnd_broadcast(&dispatch->changed);
+   mtx_unlock(&dispatch->mutex);
+}
+
+static inline void submit_dispatch_stop(struct submit_dispatch *dispatch)
+{
+   mtx_lock(&dispatch->mutex);
+   dispatch->stopping = true;
+   cnd_broadcast(&dispatch->changed);
+   mtx_unlock(&dispatch->mutex);
+   thrd_join(dispatch->thread, NULL);
+   cnd_destroy(&dispatch->changed);
+   mtx_destroy(&dispatch->mutex);
+}
diff --git a/src/vulkan/wsi/videoout_refresh_policy.h b/src/vulkan/wsi/videoout_refresh_policy.h
new file mode 100644
--- /dev/null
+++ b/src/vulkan/wsi/videoout_refresh_policy.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef VIDEOOUT_REFRESH_POLICY_H
+#define VIDEOOUT_REFRESH_POLICY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define VIDEOOUT_ATTRIBUTE3_HIGH_FRAME_RATE 0x40u
+#define VIDEOOUT_ATTRIBUTE3_VRR 0x40000u
+
+enum videoout_refresh_observation {
+   VIDEOOUT_REFRESH_RESTORE,
+   VIDEOOUT_REFRESH_HIGH_PERIOD,
+   VIDEOOUT_REFRESH_VRR_IDLE_POSSIBLE,
+};
+
+/* After a successful VideoOut request, an idle VRR screen can sit around 48 Hz
+ * until the first flip. Keep that mode pending the hardware observation.
+ * Retain the normal restoration path for a failed sample or fixed 60 Hz.
+ * https://github.com/mihawk-99/PS5_Mesa/issues/4
+ */
+static inline enum videoout_refresh_observation
+videoout_refresh_check(uint64_t period_ns, bool declares_vrr)
+{
+   if (period_ns > 0 && period_ns <= UINT64_C(12500000))
+      return VIDEOOUT_REFRESH_HIGH_PERIOD;
+   if (declares_vrr && period_ns > UINT64_C(18500000) && period_ns <= UINT64_C(25000000))
+      return VIDEOOUT_REFRESH_VRR_IDLE_POSSIBLE;
+   return VIDEOOUT_REFRESH_RESTORE;
+}
+
+#endif
diff --git a/src/util/ps5-cond-wait.h b/src/util/ps5-cond-wait.h
new file mode 100644
--- /dev/null
+++ b/src/util/ps5-cond-wait.h
@@ -0,0 +1,15 @@
+#pragma once
+
+/* C11 condition variables use TIME_UTC. The caller measures and bounds the
+ * remaining time on the monotonic clock before entering this wait. */
+static inline int ps5_cond_wait_for(cnd_t *condition, mtx_t *mutex, uint64_t remaining_ns)
+{
+   struct timespec until;
+   if (timespec_get(&until, TIME_UTC) != TIME_UTC)
+      return thrd_error;
+
+   const uint64_t nanos = until.tv_nsec + remaining_ns;
+   until.tv_sec += nanos / UINT64_C(1000000000);
+   until.tv_nsec = nanos % UINT64_C(1000000000);
+   return cnd_timedwait(condition, mutex, &until);
+}

+
+/* RPCS3 Qt handoff. Call after destroying all swapchains AND the Vulkan
+ * instance; external synchronization is required against Vulkan creation.
+ * Never grant EGL ownership after a failed close or while images are live.
+ * This is an application integration API, not a Vulkan extension. */
+PUBLIC VkResult wsi_videoout_release_output(void);
+PUBLIC VkResult
+wsi_videoout_release_output(void)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   struct wsi_videoout_output *out = &videoout_output;
+   mtx_lock(&out->lock);
+   if (out->active_swapchains || out->queue_count || out->releasing) {
+      mtx_unlock(&out->lock);
+      return VK_ERROR_NATIVE_WINDOW_IN_USE_KHR;
+   }
+   out->releasing = true;
+   out->stop_thread = true;
+   cnd_broadcast(&out->changed);
+   const bool join = out->thread_started;
+   const thrd_t thread = out->thread;
+   mtx_unlock(&out->lock);
+   if (join)
+      thrd_join(thread, NULL);
+   mtx_lock(&out->lock);
+   out->thread_started = false;
+   out->stop_thread = false;
+   VkResult result = VK_SUCCESS;
+   if (out->handle >= 0) {
+      if (out->high_frame_rate)
+         sceVideoOutConfigureOutput(out->handle, PS5_VIDEO_OUT_MODE_RESTORE, NULL, NULL, NULL);
+      const int closed = sceVideoOutClose(out->handle);
+      if (closed != 0) {
+         fprintf(stderr, "wsi/videoout: display handoff close failed: 0x%08x\n", (unsigned)closed);
+         result = VK_ERROR_INITIALIZATION_FAILED;
+         goto done;
+      }
+      out->handle = -1;
+   }
+   out->opened = false;
+   out->high_frame_rate = false;
+   out->modes_settled = false;
+   out->high_mode_offered = false;
+   for (uint32_t i = 0; i < out->set_count; i++) {
+      struct wsi_videoout_set *set = &out->sets[i];
+      const size_t bytes = VIDEOOUT_BUFFERS * set->size->buffer_bytes;
+      set->registered = false;
+      if (set->buffers) {
+         if (munmap(set->buffers, bytes) != 0) {
+            result = VK_ERROR_MEMORY_MAP_FAILED;
+            continue; /* Keep the physical allocation backing a live mapping. */
+         }
+         set->buffers = NULL;
+      }
+#if defined(__PROSPERO__)
+      if (set->physical >= 0) {
+         if (sceKernelReleaseDirectMemory(set->physical, bytes) != 0) {
+            result = VK_ERROR_MEMORY_MAP_FAILED;
+            continue;
+         }
+         set->physical = -1;
+      }
+#endif
+   }
+   if (result == VK_SUCCESS) {
+      memset(out->sets, 0, sizeof(out->sets));
+      out->set_count = 0;
+      memset(out->buffer, 0, sizeof(out->buffer));
+      out->flip_argument = 0;
+      out->queue_head = 0;
+   }
+done:
+   out->releasing = false;
+   mtx_unlock(&out->lock);
+   return result;
+}
